<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>mesh-kvm</vendor>
  <action id="io.github.benbone21.mesh-kvm.apply-update">
    <description>Install a signed mesh-kvm update</description>
    <message>mesh-kvm needs to install an update</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mesh-kvm/apply-update</annotate>
  </action>
</policyconfig>
